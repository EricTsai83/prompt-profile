    <header>
      <h3><span data-l="en" lang="en">Plan first</span><span data-l="zh-TW" lang="zh-Hant-TW">先規劃</span></h3>
      <span class="meter high"
    ><i class="on"></i><i class="on"></i><i class="on"></i><span
      class="meter-label"
