// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderHtml > matches snapshot 1`] = `
"<!doctype html>
    <html lang="en" data-look="classic" data-composition="showcase" data-hero="clock" data-signatures="none" data-detail-width="full">
      <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <meta name="referrer" content="no-referrer" />
        <meta
          http-equiv="Content-Security-Policy"
          content="default-src 'none'; style-src 'unsafe-inline'; img-src data:"
        />
        <title>The Midnight Architect · prompt-profile</title>
        <style>
          :root{color-scheme:light dark;--bg:#f6f6f3;--fg:#1d1d1f;--muted:#6b6b70;--card:#ffffff;--border:#e6e6e1;--accent:#5b5bd6;--accent-soft:#ececfb;--warn:#9a5800;--empty:#ececea;--p0:#4f7cff;--p1:#f2994a;--p2:#27ae60;--p3:#eb5757;--p4:#9b51e0;--p5:#2bb3c0;--po:#d3d6dc;--on-accent:#fff;--positive:#1f9d55;--shadow:rgba(0,0,0,.18);--font-body:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang TC","Noto Sans TC","Microsoft JhengHei",sans-serif;--title-font:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang TC","Noto Sans TC","Microsoft JhengHei",sans-serif;--title-weight:700;--title-size:clamp(32px,5.6vw,58px);--title-tracking:-.02em;--title-measure:none;--prose-font:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang TC","Noto Sans TC","Microsoft JhengHei",sans-serif;--prose-intro:20px;--hero-border:1px solid var(--border);--hero-top:1px solid var(--border);--hero-bottom:1px solid var(--border);--hero-radius:24px;--topbar-rule:none;--page:1080px;--space-1:4px;--space-2:8px;--space-3:12px;--space-4:16px;--space-6:24px;--space-8:32px;--space-12:48px;--reading:65ch;--gutter:clamp(20px,4vw,48px);--column:740px;--panel-top:24px;--overview-columns:minmax(0,1.35fr) minmax(0,1fr)}
@media (prefers-color-scheme:dark){:root{--bg:#121214;--fg:#ececee;--muted:#9a9aa2;--card:#1c1c20;--border:#2c2c33;--accent:#9d9dff;--accent-soft:#25254a;--warn:#f0b35a;--empty:#26262c;--p0:#4f7cff;--p1:#f2994a;--p2:#27ae60;--p3:#eb5757;--p4:#9b51e0;--p5:#2bb3c0;--po:#454952;--on-accent:#fff;--positive:#1f9d55;--shadow:rgba(0,0,0,.18)}}
@media print{html:root{--bg:#fff;--fg:#17212b;--muted:#46515b;--card:#fff;--border:#bdc5cc;--accent:#304d6a;--accent-soft:#e6ebef;color-scheme:light}}
.hero{--id-bg:var(--card);--id-fg:var(--fg);--id-muted:var(--muted);--id-split:transparent}

.view-input{position:absolute;width:1px;height:1px;padding:0;margin:-1px;clip-path:inset(50%);overflow:hidden;white-space:nowrap}
.view-nav{display:flex;gap:6px;margin:4px 0 24px;padding:5px;background:var(--card);border:1px solid var(--border);border-radius:14px;width:fit-content}
.view-nav label,.page-turn{cursor:pointer;border-radius:10px;padding:10px 20px;font-weight:650;color:var(--muted);display:inline-block}
.view-nav label:hover,.page-turn:hover{color:var(--fg);background:var(--accent-soft)}
#report-overview:checked~.page label[for="report-overview"],#report-detail:checked~.page label[for="report-detail"]{background:var(--accent-soft);color:var(--fg)}
#report-overview:focus-visible~.page .view-nav label[for="report-overview"],#report-detail:focus-visible~.page .view-nav label[for="report-detail"]{outline:3px solid var(--accent);outline-offset:3px}
#report-overview:checked~.page .report-view-detail,#report-detail:checked~.page .report-view-overview{display:none}
.view-heading{margin:32px 0 24px}.view-heading h2{font-size:clamp(24px,4vw,34px);letter-spacing:-.03em}.view-heading p{margin-top:12px;max-width:680px;color:var(--muted)}
.overview-charts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin:24px 0 36px}
.overview-charts h2,.preference-map h2{font-size:20px}.overview-charts .note,.preference-map>.note{margin-top:12px;line-height:1.7;font-size:13px;color:var(--muted)}
.overview-bars{list-style:none;margin:24px 0 0;padding:0;display:grid;gap:16px}
.overview-bars li{display:grid;grid-template-columns:minmax(80px,1fr) minmax(40px,1fr) minmax(44px,max-content);gap:12px;align-items:center;font-size:13px}
.overview-bars small{display:block;font-size:11px;font-weight:400;color:var(--muted);white-space:nowrap}.overview-bars b{text-align:right;font-variant-numeric:tabular-nums}
.overview-bar-track{height:8px;border-radius:8px;background:var(--accent-soft);overflow:hidden}.overview-bar-track i{display:block;height:100%;background:var(--accent);border-radius:8px}
.preference-map{margin:28px 0}.preference-rows{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 44px;margin-top:28px}
.preference-row h3{font-size:14px}.preference-rail{height:6px;background:linear-gradient(90deg,var(--accent-soft),var(--border),var(--accent-soft));border-radius:8px;position:relative;margin:22px 8px 14px}
.preference-rail i{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:15px;height:15px;border-radius:50%;background:var(--card);border:2px dashed var(--muted)}
.preference-rail.unclear{background:var(--border)}.preference-rail.unclear i{display:none}.preference-rail.first i{left:0;border:2px solid var(--accent);background:var(--accent)}.preference-rail.second i{left:100%;border:2px solid var(--accent);background:var(--accent)}
.preference-ends{display:flex;justify-content:space-between;font-size:13px;color:var(--muted)}.preference-status{font-size:12px;margin-top:10px;color:var(--muted)}
.page-turn{margin:28px 0;border:1px solid var(--border)}
.report-view-detail .portrait{margin-top:32px}.report-view-detail details[open]>summary{margin-bottom:14px}.report-view-detail blockquote{line-height:1.85}
@media(max-width:640px){.overview-charts,.preference-rows{grid-template-columns:1fr}.view-nav{width:100%}.view-nav label{flex:1;text-align:center;padding:10px 8px;font-size:14px}.overview-bars li{gap:8px}}
@media print{.view-nav,.page-turn,.switch{display:none!important}.report-view{display:block!important}.report-view-detail{break-before:page}.panel,.portrait-chapter,.preference-row{break-inside:avoid}.page{max-width:none;padding:0}}

*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.6 var(--font-body)}
.page{max-width:var(--page);margin:0 auto;padding:20px 20px 56px}
h1,h2,h3{line-height:1.2;margin:0}
p{margin:0}
.topbar{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:6px 0 18px;border-bottom:var(--topbar-rule)}
.brand{font-weight:700;letter-spacing:-.01em}
.switch{display:flex;gap:2px;padding:3px;border:1px solid var(--border);border-radius:999px;background:var(--card)}
.switch label{padding:4px 12px;border-radius:999px;font-size:13px;cursor:pointer;color:var(--muted)}
.lang-input{position:absolute;opacity:0;pointer-events:none}
.hero{position:relative;overflow:hidden;border-radius:var(--hero-radius);padding:36px 40px;border:var(--hero-border);border-top:var(--hero-top);border-bottom:var(--hero-bottom);background:var(--id-bg);color:var(--id-fg)}
.hero .split{position:absolute;right:0;top:0;bottom:0;width:34%;background:var(--id-split)}
.hero .copy{position:relative;max-width:60%}
.hero h1{font-family:var(--title-font);font-weight:var(--title-weight);font-size:var(--title-size);letter-spacing:var(--title-tracking);max-width:var(--title-measure);margin-bottom:12px}
.hero .tagline{font-size:19px;line-height:1.45;color:var(--id-muted);display:block}
.hero .desc{margin-top:8px;color:var(--id-muted);font-size:14px}
.hero .report-facts{margin:18px 0 0;display:flex;flex-wrap:wrap;gap:10px 28px;font-size:13px}.hero .report-facts dt{font-size:11px;letter-spacing:.06em;text-transform:uppercase;color:var(--id-muted)}.hero .report-facts dd{margin:2px 0 0;font-weight:600;font-variant-numeric:tabular-nums}
.hero:has(.hero-clock){min-height:270px}
.hero-clock{position:absolute;right:32px;top:50%;transform:translateY(-50%);width:min(28%,210px)}
.hero .chrono{margin-top:14px;font-size:13px;font-weight:600;color:var(--id-fg)}
.hero .graphic{position:absolute;right:36px;top:28px;bottom:28px;height:calc(100% - 56px);width:auto;max-width:30%;object-fit:contain}
.sigs{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:16px 0}
.sig,.panel,.trait,.dimension,.fact,.about,.minor{background:var(--card);border:1px solid var(--border);border-radius:18px}
.sig{position:relative;padding:16px 18px;outline:none}
.sig b{display:block;font-size:26px;letter-spacing:-.02em;line-height:1.15}
.sig>span{color:var(--muted);font-size:12.5px}
.sig:hover,.sig:focus{border-color:var(--accent)}
.grid{display:grid;gap:12px;margin-bottom:12px}
.g-2{grid-template-columns:2fr 1fr}
.g-3{grid-template-columns:repeat(3,1fr)}
.g-2r{grid-template-columns:1fr 1.6fr}
.wide{margin-bottom:12px}
.panel-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap}
.panel-head h2{margin-bottom:0}.panel-head .note{margin-top:0}
.panel{padding:18px 20px}
.panel h3{font-size:14px;margin-bottom:10px}
.panel .note{color:var(--muted);font-size:12px;margin-top:6px}
.axis{fill:var(--muted);font-size:11px}
.donut{display:flex;align-items:center;gap:16px}
.donut svg{width:112px;flex:none}
.track{fill:none;stroke:var(--empty);stroke-width:14}
.seg{fill:none;stroke-width:14;stroke:var(--accent)}
.s1{stroke-opacity:.55}.s2{stroke-opacity:.25}
.donut-value{fill:var(--fg);font-size:20px;font-weight:700}
.legend,.shares,.evidence,.facts{list-style:none;margin:0;padding:0}
.legend li{display:flex;align-items:center;gap:8px;font-size:13px;margin:4px 0}
.legend b{margin-left:auto;padding-left:10px}
.dot{width:10px;height:10px;border-radius:50%;background:var(--accent);flex:none}
.dot.s1{opacity:.55}.dot.s2{opacity:.25}
.shares li{display:grid;grid-template-columns:84px 1fr 38px;align-items:center;gap:8px;font-size:13px;margin:7px 0}
.share-track{height:8px;border-radius:99px;background:var(--empty);overflow:hidden}
.share-fill{display:block;height:100%;background:var(--accent);border-radius:99px}
.shares b{text-align:right;font-size:12px}
.sub{color:var(--muted);font-size:12px;margin-top:12px}
.rings{display:flex;gap:14px;flex-wrap:wrap}
.ring{display:flex;align-items:center;gap:8px}
.ring svg{width:52px}
.ring b{display:block;font-size:17px}
.ring div>span{font-size:12px;color:var(--muted)}
.length{margin-top:14px}
.length .shares li{grid-template-columns:84px 1fr 78px}
details summary{cursor:pointer}
section>h2{font-size:20px;margin:36px 0 14px}
section .panel{margin-bottom:12px}
.traits{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:12px}
.trait{padding:18px 20px}
.trait header{display:flex;justify-content:space-between;gap:10px;align-items:flex-start;margin-bottom:6px}
.trait h3{font-size:17px}
.trait p{font-size:14px;color:var(--muted)}
.meter{display:flex;align-items:center;gap:3px;flex:none}
.meter i{width:14px;height:6px;border-radius:3px;background:var(--empty)}
.meter i.on{background:var(--accent)}
.meter-label{font-size:11px;color:var(--muted);margin-left:6px;white-space:nowrap}
.trait details{margin-top:8px}
.lead-quote{margin-top:12px}
.support{margin-top:10px;font-size:12px;color:var(--muted)}
.sub-h{font-size:14px;color:var(--muted);margin:22px 0 10px}
.minors{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:10px}
.minor{padding:12px 16px}
.minor-head{display:flex;justify-content:space-between;gap:10px;align-items:center}
.minor p{font-size:13px;color:var(--muted);margin-top:4px}
.minor details{margin-top:6px}
.trait summary,.dim-body summary{font-size:13px;color:var(--accent)}
.evidence li{margin:8px 0 0}
blockquote{margin:0;padding:6px 12px;border-left:3px solid var(--accent);color:var(--muted);font-size:13.5px;white-space:pre-wrap;overflow-wrap:anywhere}
.dims{display:grid;gap:8px}
.dimension>summary{display:flex;align-items:center;gap:12px;padding:14px 18px;list-style:none}
.dimension>summary::-webkit-details-marker{display:none}
.dimension>summary::after{content:"+";margin-left:12px;color:var(--muted);font-size:18px;line-height:1}
.dimension[open]>summary::after{content:"–"}
.dim-name{font-size:12px;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:.04em;min-width:120px}
.dim-main{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
.dim-title{font-weight:600}
.dim-summary{font-size:13.5px;color:var(--muted);font-weight:400}
.dimension.static{display:flex;align-items:center;gap:12px;padding:14px 18px}
.badge{font-size:12px;padding:2px 10px;border-radius:999px;background:var(--accent-soft);color:var(--accent);white-space:nowrap}
.badge.warn{background:transparent;border:1px solid var(--warn);color:var(--warn)}
.dim-body{padding:0 18px 16px}
.dim-body p{font-size:14px}
.warning{color:var(--warn);font-size:13px;margin-top:8px}
.section-head{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap}
.section-head h2{font-size:20px;margin:36px 0 14px}
.improves{display:grid;gap:12px}
.improve{background:var(--card);border:1px solid var(--border);border-left:4px solid var(--accent);border-radius:18px;padding:18px 20px}
.improve header{display:flex;align-items:center;gap:10px;margin-bottom:6px}
.improve-n{display:inline-grid;place-items:center;width:24px;height:24px;border-radius:50%;background:var(--accent-soft);color:var(--accent);font-size:12px;font-weight:700;flex:none}
.improve h3{font-size:17px}
.improve-pattern{font-size:14px}
.improve-impact{font-size:13px;color:var(--muted);margin-top:4px}
.improve-tip{font-size:14px;font-weight:600;margin-top:8px}
.rewrite{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}
.rw-label{display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin-bottom:4px}
.rw-after{margin:0;padding:8px 12px;border-radius:10px;background:var(--accent-soft);font-size:13.5px;white-space:pre-wrap;overflow-wrap:anywhere}
.signals{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px}
.signals li{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:12px 16px;display:flex;flex-direction:column;gap:4px}
.signals b{font-size:14px}.signals span{font-size:13px;color:var(--muted)}
.changes{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:8px}
.chg{display:grid;grid-template-columns:1fr auto auto;gap:10px;align-items:center;padding:10px 14px;border:1px solid var(--border);border-radius:12px;background:var(--card);font-size:13px}
.chg b{font-variant-numeric:tabular-nums}.chg i{font-style:normal;font-size:12px;color:var(--muted);min-width:3em;text-align:right}
.chg.good i{color:var(--positive)}.chg.bad i{color:var(--warn)}
.last-tips{margin-top:10px;font-size:13px;color:var(--muted)}
.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.fact{padding:16px 18px;font-size:14px}
.about{margin-top:36px;padding:14px 18px;font-size:13px;color:var(--muted)}
.measured{margin-top:14px}
.measured .panel{background:var(--bg)}
.foot{margin-top:28px;text-align:center;font-size:12px;color:var(--muted)}
.about summary{color:var(--fg);font-weight:600}
.about p{margin-top:8px}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
@media (max-width:1000px){.g-3{grid-template-columns:repeat(2,1fr)}.g-2r{grid-template-columns:1fr}}
@media (max-width:760px){
.hero{padding:26px 22px}.hero .copy{max-width:none}.hero .split{display:none}
.hero:has(.hero-clock){min-height:270px}
.hero-clock{position:absolute;right:32px;top:50%;transform:translateY(-50%);width:min(28%,210px)}
.hero .chrono{margin-top:14px;font-size:13px;font-weight:600;color:var(--id-fg)}
.hero .graphic{position:static;display:block;height:auto;width:62%;max-width:none;margin:18px 0 0 auto}
.hero:has(.hero-clock){min-height:0}
.hero-clock{position:static;transform:none;width:70%;margin:18px auto 0}
.sigs{grid-template-columns:repeat(2,1fr)}.rewrite{grid-template-columns:1fr}.g-2,.g-3,.g-2r{grid-template-columns:1fr}
.dim-name{min-width:0;flex-basis:100%}.dimension>summary,.dimension.static{flex-wrap:wrap;gap:6px 12px}
}

.cols{display:grid;grid-template-columns:repeat(var(--n),1fr);gap:4px;height:170px;align-items:end}
.hours{--n:24}.weekdays{--n:7;gap:10px}
.col{position:relative;display:flex;flex-direction:column;justify-content:flex-end;height:100%;padding-bottom:20px;outline:none}
.col-fill{display:block;border-radius:4px 4px 2px 2px;background:var(--accent);opacity:.35;transition:opacity .15s}
.col-fill.peak,.col:hover .col-fill,.col:focus .col-fill{opacity:1}
.col-label{position:absolute;bottom:0;left:50%;transform:translateX(-50%);font-size:11px;color:var(--muted);white-space:nowrap}
.heat{display:grid;grid-template-columns:28px repeat(24,minmax(0,1fr)) 56px;gap:3px;margin-top:12px}
.heat-top{position:relative;height:56px;display:flex;align-items:flex-end;outline:none}
.heat-top i{display:block;width:100%;border-radius:3px 3px 0 0;background:var(--accent);opacity:.35}
.heat-top i.peak,.heat-top:hover i,.heat-top:focus i{opacity:1}
.heat-side{position:relative;display:flex;align-items:center;outline:none}
.heat-side i{display:block;height:60%;border-radius:0 3px 3px 0;background:var(--accent);opacity:.45}
.heat-side:hover i,.heat-side:focus i{opacity:1}
.clock{margin:0;display:flex;flex-direction:column;align-items:center;gap:6px}
.clock svg{width:100%;max-width:240px;height:auto}
.clock-dial{fill:none;stroke:var(--id-muted,var(--muted));stroke-opacity:.25}
.clock-bar{stroke:var(--id-accent,var(--accent));stroke-width:7;stroke-linecap:round;stroke-opacity:.35}
.clock-bar.on{stroke-opacity:1}
.clock-tick{fill:var(--id-muted,var(--muted));font-size:11px}
.clock figcaption{font-size:13px;color:var(--id-muted,var(--muted));text-align:center}
.chapters{display:flex;gap:6px;list-style:none;margin:6px 0 18px;padding:0}
.chapters li{min-width:0;display:flex;flex-direction:column;gap:4px}
.ch-bar{height:10px;border-radius:5px;background:var(--c)}
.ch-name{font-weight:600;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ch-when{font-size:11.5px;color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.heat-h{font-size:10px;color:var(--muted);text-align:left}
.heat-d{font-size:11px;color:var(--muted);align-self:center}
.heat-c,.cal-d{position:relative;border-radius:3px;background:var(--empty);outline:none}
.heat-c{height:22px}
.cal-d{aspect-ratio:1}
:is(.heat-c,.cal-d,.scale i).l1{background:color-mix(in srgb,var(--accent) 28%,var(--empty))}
:is(.heat-c,.cal-d,.scale i).l2{background:color-mix(in srgb,var(--accent) 52%,var(--empty))}
:is(.heat-c,.cal-d,.scale i).l3{background:color-mix(in srgb,var(--accent) 76%,var(--empty))}
:is(.heat-c,.cal-d,.scale i).l4{background:var(--accent)}
.heat-c:hover,.heat-c:focus,.cal-d:hover,.cal-d:focus{box-shadow:0 0 0 2px var(--fg)}
.cal{display:flex;gap:3px;margin-top:8px}
.cal-w{display:grid;grid-template-rows:16px repeat(7,auto);gap:3px;flex:1;min-width:0;max-width:30px}
.cal-m{font-size:10px;color:var(--muted);white-space:nowrap;overflow:visible}
.cal-d.out{background:transparent}
.scale{display:flex;align-items:center;gap:3px;justify-content:flex-end;font-size:11px;color:var(--muted);margin-top:10px}
.scale i{width:11px;height:11px;border-radius:3px;background:var(--empty)}
.scale i:first-of-type{margin-left:6px}.scale i:last-of-type{margin-right:6px}
.ranks{list-style:none;margin:0;padding:0}
.ranks li{display:grid;grid-template-columns:minmax(0,10em) 1fr 38px;align-items:center;gap:10px;font-size:13px;margin:9px 0}
.rank-name{display:flex;align-items:center;gap:8px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ranks b{text-align:right;font-size:12px}
.stack{display:flex;align-items:flex-end;gap:3px;height:170px;margin-top:8px}
.stack-w{position:relative;flex:1;height:100%;display:flex;align-items:flex-end;outline:none}
.stack-bar{display:flex;flex-direction:column-reverse;width:100%;border-radius:3px;overflow:hidden;opacity:.9}
.stack-w:hover .stack-bar,.stack-w:focus .stack-bar{opacity:1;box-shadow:0 0 0 2px var(--fg)}
.tip{cursor:default}
.tip:hover::after,.tip:focus::after{position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%);z-index:20;width:max-content;max-width:min(240px,80vw);padding:6px 9px;border-radius:8px;background:var(--fg);color:var(--bg);font-size:12px;line-height:1.4;font-weight:500;white-space:normal;text-align:left;pointer-events:none;box-shadow:0 4px 14px var(--shadow)}
.tip-l:hover::after,.tip-l:focus::after{left:0;transform:none}
.tip-r:hover::after,.tip-r:focus::after{left:auto;right:0;transform:none}
#lang-en:checked~.page .tip:hover::after,#lang-en:checked~.page .tip:focus::after{content:attr(data-tip-en)}
#lang-zh-TW:checked~.page .tip:hover::after,#lang-zh-TW:checked~.page .tip:focus::after{content:attr(data-tip-zh-TW)}
@media (max-width:640px){
.cal-w:nth-last-child(n+19){display:none}
.cols{height:140px}.hours{gap:2px}
.heat{grid-template-columns:20px repeat(24,minmax(0,1fr)) 28px;gap:2px}
.heat-top{height:34px}
.chapters{flex-direction:column}
.heat-c{height:14px}
.heat-h{font-size:9px}
.stack{height:140px;gap:2px}
}

.cap-lead{display:flex;flex-direction:column;gap:12px}
.cap-note{margin:-6px 0 12px}
.tech-callout{display:inline-block;margin:0;padding:5px 12px;border-radius:999px;background:var(--accent-soft);color:var(--accent);font-size:12.5px;font-weight:600;align-self:flex-start}
.tech-time{display:grid;grid-template-columns:minmax(9em,13em) repeat(var(--months),minmax(0,1fr));gap:3px;align-items:center}
.tt-m{font-size:11px;color:var(--muted);text-align:center}
.tt-name{position:relative;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;outline:none}
.tt-c{position:relative;height:20px;border-radius:4px;background:var(--empty);outline:none}
.tt-c:hover,.tt-c:focus{box-shadow:0 0 0 2px var(--fg)}
.tt-c.nodata{background:repeating-linear-gradient(135deg,var(--empty) 0 4px,transparent 4px 8px)}
:is(.tt-c).l1{background:color-mix(in srgb,var(--accent) 28%,var(--empty))}
:is(.tt-c).l2{background:color-mix(in srgb,var(--accent) 52%,var(--empty))}
:is(.tt-c).l3{background:color-mix(in srgb,var(--accent) 76%,var(--empty))}
:is(.tt-c).l4{background:var(--accent)}
.caps{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.cap{background:var(--card);border:1px solid var(--border);border-radius:18px;padding:18px 20px;display:flex;flex-direction:column;gap:12px}
.cap-extend{grid-row:span 2}
.cap header h3{font-size:17px}.cap header p{font-size:12.5px;color:var(--muted);margin-top:2px}
.cap-ms{list-style:none;margin:0;padding:0}
.cap-m{position:relative;display:grid;grid-template-columns:minmax(0,13em) 1fr 4.2em;align-items:center;gap:10px;font-size:13px;padding:4px 0;outline:none}
.cap-m b{text-align:right;font-size:12.5px;font-variant-numeric:tabular-nums}
.cap-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cap-named h4{margin:0 0 6px;font-size:12px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted)}
.cap-named ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
.cap-item{padding:10px 12px;border:1px solid var(--border);border-radius:12px}
.ci-head{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.ci-head b{font-size:13.5px;overflow-wrap:anywhere}
.ci-tag{font-size:11px;padding:1px 8px;border-radius:999px;background:var(--accent-soft);color:var(--accent)}
.cap-item p{font-size:12.5px;color:var(--muted);margin-top:4px}
.ci-when{display:block;font-size:11.5px;color:var(--muted);margin-top:4px}
.cap-named ul:has(.cap-chip){flex-direction:row;flex-wrap:wrap}
.cap-chip{position:relative;padding:4px 10px;border-radius:999px;border:1px solid var(--border);font-size:12.5px;outline:none}
.cap-chip b{color:var(--accent);margin-left:4px}
.cap-hidden{font-size:12px;color:var(--muted);margin-top:6px}
@media (max-width:760px){.caps{grid-template-columns:1fr}.cap-extend{grid-row:auto}.tech-time{grid-template-columns:minmax(7em,9em) repeat(var(--months),minmax(0,1fr))}.tt-name{font-size:12px}}
.page [data-l]{display:none}
#lang-en:checked~.page [data-l="en"]{display:revert}#lang-en:checked~.page label[for="lang-en"]{background:var(--accent);color:var(--on-accent)}#lang-en:focus-visible~.page label[for="lang-en"]{outline:3px solid var(--accent);outline-offset:2px}
#lang-zh-TW:checked~.page [data-l="zh-TW"]{display:revert}#lang-zh-TW:checked~.page label[for="lang-zh-TW"]{background:var(--accent);color:var(--on-accent)}#lang-zh-TW:focus-visible~.page label[for="lang-zh-TW"]{outline:3px solid var(--accent);outline-offset:2px}

html[data-composition=document] .identity-signatures{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin:28px 0 8px}
.identity-signatures article{border-top:2px solid var(--accent);padding:18px 0}.identity-signatures h2{font-size:16px;line-height:1.5}.identity-signatures p{font-size:13px;line-height:1.8;color:var(--muted);margin-top:8px}
[data-composition=document] .hero{background:var(--card);color:var(--fg);overflow:visible}
[data-composition=document] .hero .copy{max-width:none}
[data-composition=document] .hero .tagline{color:var(--fg);max-width:760px;font-size:20px;line-height:1.6}
[data-composition=document] .hero .desc{color:var(--muted);max-width:760px;line-height:1.8}
[data-composition=document] .hero .graphic,[data-composition=document] .hero .chrono{display:none}
[data-composition=document] .hero .report-facts{border-top:1px solid var(--border);padding-top:16px;margin-top:22px;color:var(--muted);font-size:11px}
[data-composition=document] .hero .report-facts dt{color:var(--muted);font-size:10px}
[data-composition=document] .view-heading h2{font-size:22px}
[data-composition=document] .view-heading p{font-size:13px}
:where([data-composition=document]) .preference-row:has(.unclear) .preference-rail,:where([data-composition=document]) .preference-row:has(.unclear) .preference-ends{display:none}
[data-hero=split] .hero{display:grid;grid-template-columns:1.2fr 1fr;gap:32px}html[data-signatures=stacked] .identity-signatures{display:grid!important;grid-template-columns:1fr;gap:0;margin:0}html[data-signatures=stacked] .identity-signatures article{padding:12px 0;border-top:1px solid var(--border)}html[data-signatures=stacked] .identity-signatures article:first-child{border-top:0}html[data-signatures=stacked] .identity-signatures p{margin-top:4px}
[data-hero=editorial] .hero{background:transparent}html[data-signatures=ledger] .identity-signatures{grid-template-columns:1fr;gap:0;max-width:var(--column)}html[data-signatures=ledger] .identity-signatures article{display:grid;grid-template-columns:200px 1fr;gap:24px;border-top:1px solid var(--border);padding:16px 0}html[data-signatures=ledger] .identity-signatures p{margin:0}[data-detail-width=reading] .report-view-detail{max-width:var(--column);margin:auto}[data-detail-width=reading] .portrait-intro{font-family:var(--prose-font);font-size:var(--prose-intro)}[data-detail-width=reading] .portrait-chapter{border-top:1px solid var(--border);padding-top:28px}
:where([data-composition=document]) .counter-evidence{border-left:2px dashed var(--warn);padding-left:16px}
@media(max-width:700px){html[data-composition=document] .identity-signatures{grid-template-columns:1fr;gap:0}[data-hero=split] .hero{display:block}html[data-signatures=ledger] .identity-signatures article{grid-template-columns:1fr;gap:6px}html[data-composition=document] .hero h1{overflow-wrap:anywhere}html[data-composition=document] .report-facts{display:grid;gap:12px}}
@media print{html[data-composition=document] .hero{break-inside:avoid}html[data-composition=document] .identity-signatures{break-inside:avoid}}

html:root .page{padding:var(--space-8) var(--gutter) var(--space-12)}
html:root .report-view{line-height:1.75}
html:root .view-heading{margin:var(--space-8) 0 var(--space-6)}
html:root .view-heading p{max-width:var(--reading);margin-top:var(--space-2)}
html:root .hero{padding:var(--space-8)}
html[data-hero=editorial] .hero{padding:var(--space-8) 0}
html:root .hero .desc{max-width:var(--reading)}
html:root .hero h1{line-height:1.12}
html:root .identity-signatures{margin-top:var(--space-6);margin-bottom:0}
html[data-signatures=stacked] .identity-signatures{margin:0}
html:root .grid,html:root .overview-charts{gap:var(--space-6);margin:0 0 var(--space-8)}
html:root .panel{padding:var(--space-6);margin-bottom:0}
html:root .wide{margin-bottom:var(--space-6)}
html:root .grid>.panel,html:root .overview-charts>.panel{margin:0}
html:root section>h2,html:root .section-head h2{margin:var(--space-12) 0 var(--space-4);line-height:1.3}
html:root .panel-head{margin-bottom:var(--space-4)}
html:root .overview-bars{margin-top:var(--space-4);gap:var(--space-3)}
html:root .overview-charts .note,html:root .preference-map>.note{margin-top:var(--space-3)}
html:root .preference-map{margin:var(--space-8) 0}
html:root .preference-rows{gap:var(--space-6) var(--space-8);margin-top:var(--space-6)}
html:root .portrait{max-width:var(--reading);margin:var(--space-8) auto var(--space-12)}
html:root .portrait h2{margin-top:0}
html:root .portrait-intro{margin-top:var(--space-4);line-height:1.65}
html:root .portrait-chapter{margin-top:var(--space-8)}
html:root .portrait-chapter h3{margin-bottom:var(--space-3);line-height:1.4}
html:root .portrait-chapter>p{font-size:16px;line-height:1.8}
html:root .portrait-evidence blockquote{margin:var(--space-3) 0;padding:var(--space-2) var(--space-4)}
html:root .traits,html:root .improves,html:root .caps{gap:var(--space-6)}
html:root .trait,html:root .improve{padding:var(--space-6);border-radius:8px}
html:root .dim-body{padding:0 var(--space-6) var(--space-6)}
html:root .dimension>summary{padding:var(--space-4) var(--space-6)}
html:root .about{margin-top:var(--space-12);padding:var(--space-6);line-height:1.75}
html:root .foot{margin-top:var(--space-6)}
@media(max-width:640px){html:root .page{padding:var(--space-4) 20px var(--space-8)}html:root .hero,html:root .panel,html:root .trait,html:root .improve{padding:var(--space-4)}html[data-hero=editorial] .hero{padding:var(--space-6) 0}html:root .grid{grid-template-columns:1fr}html:root .portrait-chapter>p{font-size:15px}}
/* Open composition: statistics are a strip, comparisons share a field, prose follows rules. */
html:root :is(.sig,.panel,.trait,.dimension,.fact,.about,.minor,.improve,.cap,.cap-item,.signals li,.chg){background:transparent;border:0;border-radius:0;box-shadow:none}
html:root .sigs{background:transparent;border:0;border-radius:0;overflow:visible;gap:24px;border-block:1px solid var(--border);padding:18px 0}
html:root .sig{padding:0;min-width:0}
html:root .panel{padding:24px 0;border-top:1px solid var(--border)}
html:root .overview-charts{grid-template-columns:var(--overview-columns);gap:40px}
html:root .traits{grid-template-columns:1fr;gap:0}
html:root .trait{display:grid;grid-template-columns:minmax(160px,1fr) minmax(0,2fr);column-gap:32px;padding:24px 0;border-top:1px solid var(--border)}
html:root .trait>header{grid-column:1;grid-row:span 3;display:block}
html:root .trait>header .badge{display:inline-block;margin-top:8px}
html:root .trait>:not(header){grid-column:2}
html:root .trait blockquote{margin-top:12px}
html:root .dimension{border-top:1px solid var(--border)}
html:root .dimension>summary,html:root .dimension.static{padding:18px 0}
html:root .dim-body{padding:0 0 24px}
html:root .caps{grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:32px 40px}
html:root .cap{padding:24px 0;border-top:2px solid var(--border)}
html:root .cap-item{padding:10px 0;border-top:1px solid var(--border)}
html:root .improves{gap:0;max-width:var(--reading)}
html:root .improve{padding:24px 0;border-top:1px solid var(--border)}
html:root .signals li{padding:12px 0;border-top:1px solid var(--border)}
html:root .chg{padding:10px 0;border-bottom:1px solid var(--border)}
html:root .improve-impact{margin-top:8px}
html:root .about{padding:24px 0;border-top:1px solid var(--border);max-width:var(--reading)}
html:root .panel{padding-top:var(--panel-top)}
@media(min-width:900px){html:root .report-view-detail .portrait{max-width:none;display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1fr);column-gap:48px}html:root .portrait>h2,html:root .portrait>.portrait-intro{grid-column:1/-1;max-width:var(--reading)}html:root .portrait-chapter{grid-column:1;max-width:var(--reading)}html:root .portrait-preferences{grid-column:2;grid-row:3 / span 12;align-self:start;margin-top:32px;font-size:13px}}
@media(max-width:760px){html:root .caps,html:root .overview-charts{grid-template-columns:1fr}html:root .trait{display:block}html:root .trait>header{display:flex}html:root .trait>header .badge{margin-top:0}html:root .sigs{gap:20px}html:root .panel,html:root .trait,html:root .improve{padding:20px 0}}
@page{size:A4;margin:16mm 17mm 18mm}
@media print{
html:root body{font-size:10pt;line-height:1.5;background:var(--bg);color:var(--fg)}
html:root .page{max-width:none;padding:0;margin:0}
html:root .topbar,html:root .view-nav,html:root .page-turn,html:root .switch{display:none!important}
html:root .report-view{display:block!important;line-height:1.5}
html:root .report-view-detail{break-before:auto;max-width:none;margin:0}
html:root .hero{padding:5mm;border-radius:0;display:block;break-inside:auto;min-height:0}
html[data-hero=editorial] .hero{padding:0 0 5mm}
html:root .hero h1{font-size:25pt;line-height:1.15}
html:root .hero .tagline{font-size:13pt;line-height:1.45}
html:root .hero .desc{font-size:10pt;line-height:1.5}
html:root .identity-signatures{margin-top:4mm;gap:4mm;break-inside:auto}
html:root .identity-signatures article{padding:3mm 0;break-inside:avoid}
html:root .identity-signatures h2{font-size:10pt}
html:root .identity-signatures p{font-size:9pt;line-height:1.5}
html:root .view-heading{margin:6mm 0 4mm;break-inside:avoid;break-after:avoid}
html:root .view-heading h2,html:root section>h2,html:root .section-head h2{font-size:16pt;margin:6mm 0 3mm}
html:root h2,html:root h3,html:root h4,html:root summary{break-after:avoid}
p,li,blockquote{orphans:3;widows:3}
html:root .grid{display:grid;grid-template-columns:1fr 1fr;gap:4mm;margin-bottom:4mm}
html:root .grid>.panel{break-inside:avoid}
html:root .overview-charts{margin-bottom:4mm}
html:root .overview-charts .overview-bars{margin-top:3mm;gap:2mm}
html:root .overview-charts .note{margin-top:2mm;line-height:1.4}
html:root .preference-map{margin:4mm 0}
html:root .preference-rows{margin-top:3mm;gap:3mm 5mm}
html:root .preference-rail{margin:12px 8px 8px}
html:root .measured{grid-template-columns:repeat(3,minmax(0,1fr))}
html:root .measured .panel{padding:3mm}
html:root .measured .donut{gap:8px;flex-wrap:wrap}
html:root .measured .donut svg{width:70px}
html:root .measured .legend{font-size:8pt}
html:root .measured .shares li{grid-template-columns:minmax(42px,1fr) 1fr 45px;font-size:8pt}
html:root .sigs{margin:4mm 0}
html:root .sig{padding:3mm}
html:root .hero .copy{max-width:none}
html:root .hero .graphic,html:root .hero-clock{display:none}
html:root .cap-lead,html:root .progress{break-inside:avoid}
html:root .cap-lead>*+*{margin-top:3mm}
html:root .dims{display:block;columns:2;column-gap:4mm}
html:root .dimension{display:inline-block;width:100%;position:relative}
html:root .dimension>summary{display:block}
html:root .dimension>summary::after{display:none}
html:root .dimension .dim-name{display:block;padding-right:60px;margin:0;font-size:7.5pt}
html:root .dimension .dim-main{display:block;margin-top:2mm;font-size:8.5pt;line-height:1.45}
html:root .dimension .badge{position:absolute;top:2mm;right:3mm;margin:0;font-size:7pt;padding:1px 4px}
html:root .about h2{font-size:12pt;margin:0 0 3mm}
html:root .dimension{margin-bottom:3mm;break-inside:avoid}
html:root .dimension>summary{padding:2mm 3mm}
html:root .dim-body{padding:0 3mm 2mm}
html:root .dim-body blockquote{font-size:8.5pt;line-height:1.4;padding:2px 8px}
html:root .about{border:0;border-radius:0;border-top:1px solid var(--border);padding:4mm 0;break-inside:avoid}

html:root .cols,html:root .stack{height:100px}
html:root .heat-c{height:14px}
html:root .cap p,html:root .trait p,html:root .dim-body p,html:root .improve p{font-size:9pt;line-height:1.5}
html:root .overview-bars li{font-size:9pt;gap:8px}
html:root .panel .note{font-size:8pt;line-height:1.5}
html:root .panel{padding:4mm;margin-bottom:4mm;border-radius:0;break-inside:auto}
html:root .overview-charts{display:grid;grid-template-columns:1fr 1fr;gap:4mm}
html:root .overview-charts>.panel{margin-bottom:0;break-inside:avoid}
html:root .panel:has(.heat),html:root .panel:has(.cal),html:root .panel:has(.cols),html:root .panel:has(.stack){break-inside:avoid}
html:root .cap{display:block}
html:root .cap>*+*{margin-top:3mm}
html:root .portrait{display:block;max-width:none;margin:5mm 0}
html:root .portrait-intro{font-size:12pt;line-height:1.6}
html:root .portrait-chapter{margin-top:5mm;padding-top:0;break-inside:auto}
html:root .portrait-chapter h3{font-size:12pt}
html:root .portrait-chapter>p{font-size:10pt;line-height:1.6}
html:root .portrait-axis,html:root .cap,html:root .improve{break-inside:auto}
html:root .traits,html:root .caps,html:root .improves{display:block}
html:root .trait,html:root .cap,html:root .improve{display:block;margin-bottom:4mm;padding:3mm 0}
html:root blockquote,html:root .cap-item,html:root .preference-row,html:root svg{break-inside:avoid}
html:root blockquote{font-size:9pt;line-height:1.5}
html:root .about{margin-top:4mm;font-size:8.5pt;line-height:1.45;padding:3mm 0}
html:root .tip::after,html:root .tip::before{display:none!important}
html:root .tech-time{overflow:visible;font-size:8pt}
}
</style>
      </head>
      <body>
        <input type="radio" name="report-view" id="report-overview" class="view-input" aria-label="Visual overview" checked />
        <input type="radio" name="report-view" id="report-detail" class="view-input" aria-label="Profile &amp; evidence" />
        <input
                    type="radio"
                    name="lang"
                    id="lang-en"
                    class="lang-input"
                    checked
                  /><input
                    type="radio"
                    name="lang"
                    id="lang-zh-TW"
                    class="lang-input"

                  />
        <div class="page">
          <header class="topbar">
            <span class="brand">prompt-profile</span>
            <nav class="switch" aria-label="Language">
                    <label for="lang-en" lang="en"
                          >English</label
                        ><label for="lang-zh-TW" lang="zh-Hant-TW"
                          >中文</label
                        >
                  </nav>
          </header>
          <nav class="view-nav" aria-label="Report views">
            <label for="report-overview"><span data-l="en" lang="en">Visual overview</span><span data-l="zh-TW" lang="zh-Hant-TW">圖表總覽</span></label>
            <label for="report-detail"><span data-l="en" lang="en">Profile &amp; evidence</span><span data-l="zh-TW" lang="zh-Hant-TW">人物側寫與證據</span></label>
          </nav>
          <section class="hero">

            <div class="copy">
              <h1><span data-l="en" lang="en">The Midnight Architect</span><span data-l="zh-TW" lang="zh-Hant-TW">午夜架構師</span></h1>
              <p class="tagline"><span data-l="en" lang="en">A perfectionist who argues with AI about naming at midnight</span><span data-l="zh-TW" lang="zh-Hant-TW">半夜跟 AI 爭論命名的完美主義者</span></p>
              <p class="desc"><span data-l="en" lang="en">Ships features by day, refactors by night.</span><span data-l="zh-TW" lang="zh-Hant-TW">白天出貨，晚上重構。</span></p>

              <dl class="report-facts">
                <div>
                  <dt><span data-l="en" lang="en">Data period</span><span data-l="zh-TW" lang="zh-Hant-TW">資料區間</span></dt>
                  <dd>
                    <span data-l="en" lang="en">Apr 25, 2026 – Oct 23, 2026 · 182 days</span><span data-l="zh-TW" lang="zh-Hant-TW">2026年4月25日 – 2026年10月23日 · 182 天</span>
                  </dd>
                </div>
                <div>
                  <dt><span data-l="en" lang="en">Generated</span><span data-l="zh-TW" lang="zh-Hant-TW">產生時間</span></dt>
                  <dd>
                    <span data-l="en" lang="en">Oct 24, 2026, 10:00 AM</span><span data-l="zh-TW" lang="zh-Hant-TW">2026年10月24日 上午10:00</span>
                  </dd>
                </div>
                <div>
                  <dt><span data-l="en" lang="en">Analyzed</span><span data-l="zh-TW" lang="zh-Hant-TW">分析內容</span></dt>
                  <dd>
