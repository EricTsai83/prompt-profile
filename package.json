{
  "name": "prompt-profile",
  "version": "0.1.0",
  "description": "Analyze your past prompts from AI coding agents (Claude Code, Codex) locally and generate a personal profile.",
  "keywords": [
    "ai",
    "claude-code",
    "cli",
    "codex",
    "profile",
    "prompt"
  ],
  "homepage": "https://github.com/EricTsai83/prompt-profile#readme",
  "bugs": {
    "url": "https://github.com/EricTsai83/prompt-profile/issues"
  },
  "license": "MIT",
  "author": "Eric Tsai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EricTsai83/prompt-profile.git"
  },
  "bin": {
    "prompt-profile": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/bin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:changed": "vitest run --changed",
    "test:smoke": "vitest run --config vitest.smoke.config.ts --project data",
    "test:smoke:llm": "vitest run --config vitest.smoke.config.ts --project llm",
    "eval": "tsx scripts/eval.ts",
    "eval:compare": "tsx scripts/eval-compare.ts",
    "inspect:openings": "tsx scripts/inspect-openings.ts",
    "dev:report": "tsx scripts/dev-report.ts",
    "test:package": "pnpm build && node scripts/test-package.mjs",
    "build:binaries": "tsx scripts/build-binaries.ts",
    "test:binary": "node scripts/test-binary.mjs"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@resvg/resvg-wasm": "catalog:",
    "effect": "catalog:",
    "satori": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.4"
}
