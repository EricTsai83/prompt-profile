{
  "name": "prompt-profile",
  "version": "0.1.0",
  "description": "Analyze your past prompts from AI coding agents (Claude Code, Codex) locally and generate a personal profile.",
  "license": "MIT",
  "bin": {
    "prompt-profile": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/bin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.4"
}
